%         a(n) = -(dQ/q) * ( alpha / dPir^2 - beta / (2*dPir) );     
%         b(n) = 1 + (dQ/q) * ( 2*alpha / dPir^2 + (Rir + landaC) ); 
%         c(n) = -(dQ/q) * ( alpha / dPir^2 + beta / (2*dPir) );     
% 
%         % source term per step: cash flow * time-step (dQ corresponds to extracted mass)
%         P_now = Pir_data(n);
%         S_n = (P_now*(1-R) - Cprime) * (1-G) * dQ;  
% 
%         RHS(n) = V(n,j) + S_n;
%     end
% 
%     % Price-axis boundaries (linear approx -> second derivative = 0)
%     b(1) = 1; c(1) = -1; a(1) = 0; RHS(1) = 0;
%     idx = nPoints;
%     b(idx) = 1; a(idx) = -1; c(idx) = 0; RHS(idx) = 0;
% 
%     % Solve A * V(:,j+1) = RHS
%     V(:, j+1) = thomas_solver(a,b,c,RHS);
% 
%     % Re-apply physical boundaries after solve
%     V(:,1) = 0;               % Q=0 -> exhausted
%     V(1, :) = 0;              % P=0 -> worthless (all columns)
%     V(end, :) = V(end-1, :);  % linear at high price (all columns)
% 
%     % optional diagnostic print every 100 steps
%     if mod(j,1000)==0
%         fprintf('step %d/%d: V range [%g, %g]\n', j, J, min(V(:)), max(V(:)));
%     end
% end


%% --- CRANK-NICOLSON LOOP ---
nPoints = N+1;
aA=zeros(nPoints,1); bA=zeros(nPoints,1); cA=zeros(nPoints,1);
aB=zeros(nPoints,1); bB=zeros(nPoints,1); cB=zeros(nPoints,1);
RHS=zeros(nPoints,1);

dt = dQ/q; % scale for each Q-step

for j = 1:J
    V(:,1) = 0; % Q=0 boundary

    % Zero arrays
    aA(:)=0; bA(:)=0; cA(:)=0; aB(:)=0; bB(:)=0; cB(:)=0; RHS(:)=0;

    for n = 2:N
        P_now = Pir_data(n);

        % PDE coefficients
        alpha = 0.5 * sigmaPir^2 * P_now^2;
        beta  = (Rir - delta + ccPE*sigmaP*sigmaE) * P_now;

        % CN matrices
        aA(n) = -(dt/2) * ( alpha/dPir^2 - beta/(2*dPir) );
        bA(n) = 1 + (dt/2) * ( 2*alpha/dPir^2 + (Rir+landaC) );
        cA(n) = -(dt/2) * ( alpha/dPir^2 + beta/(2*dPir) );

        aB(n) =  (dt/2) * ( alpha/dPir^2 - beta/(2*dPir) );
        bB(n) =  1 - (dt/2) * ( 2*alpha/dPir^2 + (Rir+landaC) );
        cB(n) =  (dt/2) * ( alpha/dPir^2 + beta/(2*dPir) );

        % Cashflow for this step (scaled by dQ/q)
        CF_year = (P_now*(1-R) - Cprime)*(1-G)*q-Cfixed;
        discount_factor = (1 + Rir)^(-dt);
        S_n = CF_year * dt*discount_factor;

        % RHS
        RHS(n) = aB(n)*V(n-1,j) + bB(n)*V(n,j) + cB(n)*V(n+1,j) + S_n;
    end

    % Boundary conditions (economic)
    bA(1)=1; cA(1)=-1; RHS(1)=0;         % P=0 worthless
    bA(end)=1; aA(end)=-1; RHS(end)=0;    % dV/dP=0 at high price

    % Solve
    V(:,j+1) = thomas_solver(aA,bA,cA,RHS);

    % Reapply boundaries
    V(1,:) = 0;
    V(end,:) = V(end-1,:);
end


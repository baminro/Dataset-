%     end
% end

% ---------------------------
% Thomas solver (tridiagonal)
% ---------------------------
%% --- THOMAS SOLVER ---
function x = thomas_solver(a,b,c,d)
    n = length(b); cp=zeros(n,1); dp=zeros(n,1); x=zeros(n,1);
    cp(1) = c(1)/b(1); dp(1) = d(1)/b(1);
    for i=2:n
        denom = b(i)-a(i)*cp(i-1);
        cp(i)=c(i)/denom; dp(i)=(d(i)-a(i)*dp(i-1))/denom;
    end
    x(n)=dp(n);
    for i=n-1:-1:1
        x(i)=dp(i)-cp(i)*x(i+1);
    end
end




